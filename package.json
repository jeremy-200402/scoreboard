{
  "name": "scoreboard-weapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix apps/weapp run dev:weapp",
    "dev:weapp": "npm --prefix apps/weapp run dev:weapp",
    "build": "npm --prefix apps/weapp run build:weapp",
    "build:weapp": "npm --prefix apps/weapp run build:weapp",
    "typecheck": "npm --prefix apps/weapp exec -- tsc --noEmit --project apps/weapp/tsconfig.json",
    "typecheck:weapp": "npm --prefix apps/weapp exec -- tsc --noEmit --project apps/weapp/tsconfig.json",
    "test": "vitest run apps/weapp/src",
    "test:watch": "vitest apps/weapp/src"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
